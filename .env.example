DATABASE_URL="postgresql://postgres:postgres@localhost:5432/actual_dashboard"

# Path to your household config (account names, categories, skip lists).
# Unset = config/dashboard.json, falling back to config/dashboard.example.json.
# Copy the example, fill in your real values, and keep it out of git.
# In the container point this at the mounted volume: /data/config.json
DASHBOARD_CONFIG=""

# Path where Actual Budget sync data is cached on the host (mounted volume).
# Defaults to /tmp/actual-sync-data if unset (ephemeral — re-downloads on every restart).
# On Unraid: /mnt/user/appdata/actual-dashboard
ACTUAL_DATA_DIR="/mnt/user/appdata/actual-dashboard"

ACTUAL_SERVER_URL="http://YOUR-SERVER-IP:5006"
ACTUAL_PASSWORD=""
ACTUAL_SYNC_ID=""

SITE_PASSWORD="changeme"

ANTHROPIC_API_KEY=""

# Comma-separated list of EXACTLY 3 category names to show as spotlight cards.
# If unset or invalid, the spotlight column is hidden.
SPOTLIGHT_CATEGORIES="Grocery,Takeout,Subscriptions"

# Browserless PDF/PNG rendering service (Phase 2 of PRD #7).
# URL the Next.js app uses to reach the browserless container.
BROWSERLESS_URL="http://browserless:3000"
# Shared token configured on the browserless container (TOKEN env var there).
BROWSERLESS_TOKEN=""
# Base URL the browserless container should fetch app pages from when rendering.
# In docker-compose this is typically http://app:3000; for local dev use http://localhost:3000.
PDF_RENDER_BASE_URL="http://localhost:3000"
# Random secret token that lets the headless browser bypass auth when rendering.
PDF_RENDER_AUTH_TOKEN=""

# Resend API key for outbound email (monthly reports, sync alerts). Empty = no-op.
RESEND_API_KEY=""
# Verified sender address, e.g. "Actual Dashboard <dashboard@example.com>".
EMAIL_FROM=""
# Comma-separated list of recipient addresses. Empty = no-op.
EMAIL_RECIPIENTS=""

# Cron expression for automatic sync runs. Empty disables the schedule.
# Example: "0 */6 * * *" runs every 6 hours.
SYNC_CRON=""
# Cron expression for monthly email report. Empty disables.
# Example: "0 8 1 * *" sends on the 1st of each month at 8am.
EMAIL_CRON=""
# Timezone for all scheduler cron expressions.
CRON_TIMEZONE="America/New_York"

# Postgres data is stored at /mnt/user/appdata/actual-dashboard/pgdata on the host.
# To change this, edit the volume path directly in docker-compose.yml.

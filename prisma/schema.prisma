generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           String                   @id
  name         String
  type         String?
  balance      Int                      @default(0)
  transactions Transaction[]
  snapshots    AccountBalanceSnapshot[]
}

model AccountBalanceSnapshot {
  accountId String
  date      DateTime @db.Date
  balance   Int
  account   Account  @relation(fields: [accountId], references: [id])

  @@id([accountId, date])
  @@index([accountId, date])
}

model Category {
  id              String           @id
  name            String
  groupName       String?
  hidden          Boolean          @default(false)
  isIncome        Boolean          @default(false)
  transactions    Transaction[]
  categoryBudgets CategoryBudget[]
}

model Transaction {
  id         String    @id
  date       DateTime
  amount     Int
  payee      String?
  notes      String?
  categoryId String?
  accountId  String?
  category   Category? @relation(fields: [categoryId], references: [id])
  account    Account?  @relation(fields: [accountId], references: [id])

  @@index([date])
  @@index([categoryId])
  @@index([accountId])
}

model CategoryBudget {
  id             String   @id @default(cuid())
  month          String
  budgetedAmount Int
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, month])
  @@index([month])
}

model SyncLog {
  id          String   @id @default(cuid())
  syncedAt    DateTime @default(now())
  status      String
  message     String?
  recordCount Int?
}

model DailyInsight {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  content   String
  monthKey  String

  @@index([monthKey])
}

/// A note the household writes about a month, handed to the AI as context.
///
/// Free text on purpose. Nothing computes on it and nothing on the dashboard
/// changes because of it — it exists so the insight can say why a category
/// jumped, instead of guessing. `monthEnd` is null for the common single-month
/// note and set when one event spans several months.
model MonthNote {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  monthStart String
  monthEnd   String?
  note       String

  @@index([monthStart])
}

/// A savings fund: money the household has earmarked for one purpose.
///
/// Funds live below accounts and Actual knows nothing about them, so every
/// figure here is typed in by hand on the admin page. Nothing syncs, nothing
/// reconciles against a real account balance, and no fund total feeds net
/// worth or the Savings metric — this is a separate ledger the household
/// keeps, displayed beside the synced figures rather than mixed into them.
///
/// `group` is the horizon the household thinks in ("Short Term", "Long
/// Term"), not where the money sits. It is a plain string so a third group
/// can be added without a migration; the admin form only offers groups that
/// already exist, so the free text does not become a typo split.
model SavingsFund {
  id           String               @id @default(cuid())
  name         String               @unique
  group        String
  createdAt    DateTime             @default(now())
  /// The month from which this fund stops appearing, `YYYY-MM`, or null while
  /// it is live. Recorded as a month rather than a flag so a past month still
  /// shows the funds that existed then — archiving a fund in September must
  /// not erase it from March.
  archivedFrom String?
  balances     SavingsFundBalance[]

  @@index([group])
}

/// One month-end balance for one fund, in cents.
///
/// Month-end only, keyed by `YYYY-MM`: the household records where a fund
/// stood, not the day it was checked. A month with no row is not zero — the
/// fund's last known balance carries forward, and the UI marks a carried
/// figure with the month it came from. Negative balances are real and stored
/// as-is; a fund can be overdrawn against its own plan.
model SavingsFundBalance {
  fundId   String
  monthKey String
  balance  Int
  fund     SavingsFund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@id([fundId, monthKey])
  @@index([monthKey])
}
